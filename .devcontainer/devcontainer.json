{
  "name": "Odoo 17 Development",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8069],
  "portsAttributes": {
    "8069": {
      "label": "Odoo Web",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "docker-compose up -d web",
  "customizations": {
    "vscode": {
      "extensions": [
        "odooide.odoo-snippets",
        "ms-python.python"
      ]
    }
  }
}
