{
  "name": "Odoo 17 Development",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {}
  },
  "forwardPorts": [8069],
  "portsAttributes": {
    "8069": {
      "label": "Odoo Web",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "docker-compose up -d",
  "customizations": {
    "vscode": {
      "extensions": [
        "odooide.odoo-snippets",
        "ms-python.python"
      ]
    }
  }
}
