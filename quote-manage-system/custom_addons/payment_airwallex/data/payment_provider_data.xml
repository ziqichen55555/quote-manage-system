<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Seed the Airwallex provider row.

        ``noupdate="1"`` so a future ``-u payment_airwallex`` does NOT clobber
        admin-edited fields (state, credentials). XML is a first-install seed
        only, in line with the editor-first policy used by ``quote_manage_ui``.
    -->
    <record id="payment_provider_airwallex" model="payment.provider">
        <field name="name">Airwallex</field>
        <field name="code">airwallex</field>
        <field name="state">disabled</field>
        <field name="module_id" ref="base.module_payment_airwallex"/>
        <field name="image_128" type="base64" file="payment_airwallex/static/description/icon.png"/>
        <field name="payment_method_ids"
               eval="[Command.set([ref('payment.payment_method_card')])]"/>
        <field name="redirect_form_view_id" ref="payment_airwallex.redirect_form"/>
    </record>

</odoo>
