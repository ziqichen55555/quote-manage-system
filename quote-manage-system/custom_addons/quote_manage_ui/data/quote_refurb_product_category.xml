<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": editor-first policy. The category/tag/menu records below are
         SEEDS — they are created on first install, and from that point on the
         backend (or Website Builder) is the source of truth. `-u` MUST NOT reset
         names/sequences/parents back to the XML values. To force-resync from XML,
         clear noupdate on individual ir.model.data rows before running -u. -->
    <data noupdate="1">
        <function model="product.public.category" name="_quote_remove_legacy_demo_root_categories"/>
        <function model="website" name="_quote_clear_website_menu_template_cache"/>

        <!-- Sub-category for imported refurb systems (under Saleable) -->
        <record id="product_category_computer_systems_refurb" model="product.category">
            <field name="parent_id" ref="product.product_category_1"/>
            <field name="name">Computer Systems</field>
        </record>

        <!-- Website top-level categories (sequence: Laptops → Desktops → …) -->
        <record id="public_cat_laptops" model="product.public.category">
            <field name="name">Laptops</field>
            <field name="sequence" eval="10"/>
        </record>

        <!-- Internal categories (inventory / reporting) — use with product.template categ_id -->
        <record id="product_category_monitors" model="product.category">
            <field name="parent_id" ref="product.product_category_1"/>
            <field name="name">Monitors &amp; Displays</field>
        </record>
        <record id="product_category_docks" model="product.category">
            <field name="parent_id" ref="product.product_category_1"/>
            <field name="name">Docks &amp; Port Replicators</field>
        </record>
        <record id="product_category_pc_accessories" model="product.category">
            <field name="parent_id" ref="product.product_category_1"/>
            <field name="name">PC Accessories</field>
        </record>
        <record id="product_category_workstations" model="product.category">
            <field name="parent_id" ref="product.product_category_1"/>
            <field name="name">Desktops &amp; Workstations</field>
        </record>
        <record id="product_category_services" model="product.category">
            <field name="parent_id" ref="product.product_category_1"/>
            <field name="name">Services</field>
        </record>

        <!-- eCommerce navigation -->
        <record id="public_cat_desktops" model="product.public.category">
            <field name="name">Desktops &amp; Mini PCs</field>
            <field name="sequence" eval="20"/>
        </record>
        <record id="public_cat_monitors" model="product.public.category">
            <field name="name">Monitors &amp; Displays</field>
            <field name="sequence" eval="30"/>
        </record>
        <record id="public_cat_docks" model="product.public.category">
            <field name="name">Docks</field>
            <field name="sequence" eval="40"/>
        </record>
        <record id="public_cat_accessories" model="product.public.category">
            <field name="name">Accessories</field>
            <field name="sequence" eval="50"/>
        </record>
        <record id="public_cat_projectors_av" model="product.public.category">
            <field name="name">Projectors &amp; AV</field>
            <field name="sequence" eval="60"/>
        </record>
        <record id="public_cat_services" model="product.public.category">
            <field name="name">Services</field>
            <field name="sequence" eval="70"/>
        </record>
    </data>
</odoo>
