<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="icp_website_order_notify_email" model="ir.config_parameter">
            <field name="key">quote_manage_ui.website_order_notify_email</field>
            <field name="value">re-ware@cocreativeit.com</field>
        </record>
    </data>

  <!-- Unpaid website quotation: staff must NOT confirm manually. -->
    <record id="mail_template_website_quotation_staff" model="mail.template">
        <field name="name">Website Quotation: staff notification (awaiting payment)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">Website quotation {{ object.name }} — awaiting payment (do not confirm)</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or '') }}</field>
        <field name="email_to">{{ object.env['ir.config_parameter'].sudo().get_param('quote_manage_ui.website_order_notify_email', 're-ware@cocreativeit.com') }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="description">Notify staff when a customer reaches checkout payment with an unpaid website quotation.</field>
        <field name="body_html" type="html">
<div>
    <p style="color:#b45309; font-weight:bold;">
        This is an unpaid website quotation. Do <strong>not</strong> click Confirm in Odoo —
        the order should only become a Sales Order after the customer pays online.
    </p>
    <p>
        Please contact the customer and ask them to complete payment as soon as possible.
    </p>
    <ul>
        <li><strong>Quotation:</strong> <t t-out="object.name or ''">S00001</t></li>
        <li><strong>Customer:</strong> <t t-out="object.partner_id.display_name or ''">Customer</t></li>
        <li><strong>Email:</strong> <t t-out="object.partner_id.email or ''">email</t></li>
        <li><strong>Phone:</strong> <t t-out="object.partner_id.phone or object.partner_id.mobile or ''">phone</t></li>
        <li><strong>Total (incl. freight):</strong> <t t-out="format_amount(object.amount_total, object.currency_id) or ''">$0.00</t></li>
    </ul>
    <p>
        <a t-att-href="('%s/my/orders/%s' % (object.get_base_url(), object.id))">
            Customer payment link (portal)
        </a>
        ·
        <a t-att-href="('%s/web#id=%s&amp;model=sale.order&amp;view_type=form' % (object.get_base_url(), object.id))">
            Open in Odoo
        </a>
    </p>
</div>
        </field>
    </record>

  <!-- Paid website order: process delivery. -->
    <record id="mail_template_website_order_staff" model="mail.template">
        <field name="name">Website Order: staff notification (paid)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">Website order {{ object.name }} — paid, process delivery</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or '') }}</field>
        <field name="email_to">{{ object.env['ir.config_parameter'].sudo().get_param('quote_manage_ui.website_order_notify_email', 're-ware@cocreativeit.com') }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="description">Notify Re-Ware staff when a website order is confirmed after payment.</field>
        <field name="body_html" type="html">
<div>
    <p>
        Payment received. Please validate serial numbers, check the delivery address,
        and process delivery (van within 5 km or courier if further).
    </p>
    <ul>
        <li><strong>Order:</strong> <t t-out="object.name or ''">S00001</t></li>
        <li><strong>Customer:</strong> <t t-out="object.partner_id.display_name or ''">Customer</t></li>
        <li><strong>Email:</strong> <t t-out="object.partner_id.email or ''">email</t></li>
        <li><strong>Phone:</strong> <t t-out="object.partner_id.phone or object.partner_id.mobile or ''">phone</t></li>
        <li><strong>Total:</strong> <t t-out="format_amount(object.amount_total, object.currency_id) or ''">$0.00</t></li>
    </ul>
    <p><strong>Delivery address</strong></p>
    <p>
        <t t-out="object.partner_shipping_id.display_name or ''">Customer</t><br/>
        <t t-if="object.partner_shipping_id.street" t-out="object.partner_shipping_id.street"/><br t-if="object.partner_shipping_id.street"/>
        <t t-if="object.partner_shipping_id.street2" t-out="object.partner_shipping_id.street2"/><br t-if="object.partner_shipping_id.street2"/>
        <t t-if="object.partner_shipping_id.city or object.partner_shipping_id.zip">
            <t t-out="object.partner_shipping_id.city or ''"/>
            <t t-if="object.partner_shipping_id.zip"> <t t-out="object.partner_shipping_id.zip"/></t>
        </t><br t-if="object.partner_shipping_id.city or object.partner_shipping_id.zip"/>
        <t t-if="object.partner_shipping_id.state_id" t-out="object.partner_shipping_id.state_id.name"/>
        <t t-if="object.partner_shipping_id.country_id"> <t t-out="object.partner_shipping_id.country_id.name"/></t>
    </p>
    <p><strong>Products</strong></p>
    <ul>
        <t t-foreach="object.order_line.filtered(lambda l: not l.display_type)" t-as="line">
            <li>
                <t t-out="line.product_uom_qty or 0"/> x
                <t t-out="line.name or line.product_id.display_name or ''"/>
                —
                <t t-out="format_amount(line.price_subtotal, object.currency_id) or ''"/>
            </li>
        </t>
    </ul>
    <p>
        <a t-att-href="('%s/web#id=%s&amp;model=sale.order&amp;view_type=form' % (object.get_base_url(), object.id))">
            Open order in Odoo
        </a>
    </p>
</div>
        </field>
    </record>
</odoo>
