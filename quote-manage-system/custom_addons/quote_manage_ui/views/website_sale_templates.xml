<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cart_delivery_rw" inherit_id="website_sale_delivery.cart_delivery" name="Re-Ware Delivery Costs Display">
        <xpath expr="//tr[@id='order_delivery']" position="replace">
            <tr id="order_delivery">
                <td colspan="2" class="ps-0 pt-0 pb-2 border-0 text-muted">
                    <t t-if="website_sale_order and website_sale_order.carrier_id and website_sale_order._rw_is_pickup_carrier(website_sale_order.carrier_id)">
                        In-store pickup
                    </t>
                    <t t-else="">
                        Standard Shipping
                    </t>
                </td>
                <td class="text-end pe-0 pt-0 pb-2 border-0 text-muted">
                    <t t-if="website_sale_order and not website_sale_order._rw_is_pickup_carrier(website_sale_order.carrier_id) and not website_sale_order.amount_delivery">
                        <span class="text-info small" title="Enter your postcode at checkout to calculate exact shipping">Calculated at checkout</span>
                    </t>
                    <t t-elif="website_sale_order">
                        <span t-field="website_sale_order.amount_delivery"
                              class="monetary_field"
                              style="white-space: nowrap;"
                              t-options='{"widget": "monetary", "display_currency": website_sale_order.currency_id}'/>
                    </t>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
