<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Re-Ware Snippets — registered to Website Builder
         Visual reference: https://www.reware-project.com/
         Each <template id="s_rw_*"> is what gets inserted when the
         user drags the corresponding tile from the Editor panel.
         Page records call them via <t t-call="..."/> so that the
         default content is also "snippet-aware" and the Editor
         attaches the right option panel when clicked.
         ============================================================ -->

    <!-- s_rw_hero -->
    <template id="s_rw_hero" name="Re-Ware Hero">
        <section class="s_rw_hero rw-hero" data-name="Re-Ware Hero" data-snippet="s_rw_hero">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <h1 class="rw-hero-title">Turning old tech into opportunity.</h1>
                        <p class="rw-hero-sub">Your secure, compliant way to clear out old devices and help close the digital divide.</p>
                        <div class="d-flex flex-wrap gap-3 rw-hero-ctas">
                            <a href="#rw-services" class="rw-btn-coral">Learn more</a>
                            <a href="/contactus" class="rw-btn-outline-light">Donate</a>
                            <a href="/shop" class="rw-btn-coral-red d-lg-none" target="_blank" rel="noopener noreferrer">Shop</a>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="rw-hero-image rw-hero-carousel">
                            <!-- Fixed id (not datetime-based): Odoo Website Editor's
                                 Carousel "Add slide" needs a stable #id; a new id on
                                 every page render breaks Bootstrap and leaves Add slide
                                 spinning forever. -->
                            <!-- No data-bs-ride: Odoo's editor strips indicator
                                 data-bs-slide-to and pauses carousels in edit
                                 mode. Bootstrap's native auto-ride ignores that
                                 pause and crashes (_setActiveIndicatorElement on
                                 a null indicator). Autoplay is started on the
                                 public site by hero_carousel.js instead. -->
                            <div id="rwHeroCarousel" class="s_carousel s_carousel_default carousel slide carousel-fade" data-bs-interval="3000">
                                <div class="carousel-inner">
                                    <div class="carousel-item active" data-name="Slide">
                                        <img class="img-fluid d-block w-100" src="/quote_manage_ui/static/src/img/hero/hero-team-workshop-v2.jpg" data-name="Image" alt="Re-Ware team with a refurbished laptop in the workshop"/>
                                    </div>
                                    <div class="carousel-item" data-name="Slide">
                                        <img class="img-fluid d-block w-100" src="/quote_manage_ui/static/src/img/hero/hero-laptop-inspect-v2.jpg" data-name="Image" alt="Inspecting a device before donation to the community"/>
                                    </div>
                                    <div class="carousel-item" data-name="Slide">
                                        <img class="img-fluid d-block w-100" src="/quote_manage_ui/static/src/img/hero/hero-grandcarers-v2.png" data-name="Image" alt="Partnering to make a difference — Co-Creative IT &amp; Grandcarers WA"/>
                                    </div>
                                    <div class="carousel-item" data-name="Slide">
                                        <img class="img-fluid d-block w-100" src="/quote_manage_ui/static/src/img/hero/hero-gc-handover.jpg" data-name="Image" alt="Re-Ware handing over a refurbished laptop at Grandcarers WA"/>
                                    </div>
                                    <div class="carousel-item" data-name="Slide">
                                        <img class="img-fluid d-block w-100" src="/quote_manage_ui/static/src/img/hero/hero-gc-laptop-gift.jpg" data-name="Image" alt="A Grandcarers WA community member with their refurbished Re-Ware laptop"/>
                                    </div>
                                    <div class="carousel-item" data-name="Slide">
                                        <img class="img-fluid d-block w-100" src="/quote_manage_ui/static/src/img/hero/hero-gc-recipient.jpg" data-name="Image" alt="A Grandcarers WA recipient holding a refurbished Re-Ware laptop"/>
                                    </div>
                                    <div class="carousel-item" data-name="Slide">
                                        <img class="img-fluid d-block w-100" src="/quote_manage_ui/static/src/img/hero/hero-gc-setup.jpg" data-name="Image" alt="Setting up refurbished laptops with the community at Grandcarers WA"/>
                                    </div>
                                </div>
                                <ol class="carousel-indicators">
                                    <li data-bs-target="#rwHeroCarousel" data-bs-slide-to="0" class="active"/>
                                    <li data-bs-target="#rwHeroCarousel" data-bs-slide-to="1"/>
                                    <li data-bs-target="#rwHeroCarousel" data-bs-slide-to="2"/>
                                    <li data-bs-target="#rwHeroCarousel" data-bs-slide-to="3"/>
                                    <li data-bs-target="#rwHeroCarousel" data-bs-slide-to="4"/>
                                    <li data-bs-target="#rwHeroCarousel" data-bs-slide-to="5"/>
                                    <li data-bs-target="#rwHeroCarousel" data-bs-slide-to="6"/>
                                </ol>
                                <a class="carousel-control-prev o_we_no_overlay o_not_editable" href="#rwHeroCarousel" data-bs-slide="prev" aria-label="Previous" title="Previous">
                                    <span class="oi oi-chevron-left fa-2x"/>
                                    <span class="visually-hidden">Previous</span>
                                </a>
                                <a class="carousel-control-next o_we_no_overlay o_not_editable" href="#rwHeroCarousel" data-bs-slide="next" aria-label="Next" title="Next">
                                    <span class="oi oi-chevron-right fa-2x"/>
                                    <span class="visually-hidden">Next</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- s_rw_page_hero -->
    <template id="s_rw_page_hero" name="Re-Ware Page Hero">
        <section class="s_rw_page_hero rw-page-hero" data-name="Re-Ware Page Hero" data-snippet="s_rw_page_hero">
            <div class="container">
                <p class="rw-eyebrow mb-3">Section label</p>
                <h1 class="mb-3">Section title.</h1>
                <p class="lead">A short subtitle that introduces this page.</p>
            </div>
        </section>
    </template>

    <!-- s_rw_services -->
    <template id="s_rw_services" name="Re-Ware Services">
        <section class="s_rw_services rw-section rw-bg-cream" data-name="Re-Ware Services" data-snippet="s_rw_services">
            <div class="container">
                <h2 class="mb-5" style="font-size: clamp(2rem, 3.5vw, 2.6rem);">Services we offer.</h2>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="rw-card">
                            <h3>Refurb &amp; Repurpose</h3>
                            <p>We collect end-of-life devices and securely refurbish them, ready for a new home.</p>
                            <div class="rw-card-image">
                                <img src="/quote_manage_ui/static/src/img/services/refurb-repurpose.jpg" alt="Stack of devices ready for refurbishment" data-name="Image"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="rw-card">
                            <h3>Data Sanitisation</h3>
                            <p>Certified Blancco erasure (NIST 800-88). Full reports for SOCI, Privacy Act reforms and audits.</p>
                            <div class="rw-card-image">
                                <img src="/quote_manage_ui/static/src/img/services/data-sanitisation.png" alt="Secure IT disposal and certified data wipe" data-name="Image"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="rw-card">
                            <h3>Impactful Distribution</h3>
                            <p>Through partnerships with charities and programs, we donate refurbished devices to those in need.</p>
                            <div class="rw-card-image">
                                <img src="/quote_manage_ui/static/src/img/services/impactful-distribution.png" alt="Refurbished devices powering education and opportunity" data-name="Image"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- s_rw_consultation — CTA + three steps on one background (matches reware-project.com) -->
    <template id="s_rw_consultation" name="Re-Ware Consultation CTA">
        <section class="s_rw_consultation rw-section rw-bg-image rw-bg-consultation" data-name="Re-Ware Consultation" data-snippet="s_rw_consultation">
            <div class="container rw-container-narrow position-relative">
                <h2 class="rw-consultation-title mb-3 text-center">Reserve your complimentary consultation.</h2>
                <p class="mb-4 rw-consultation-lead text-center">Need a hand? We'll guide you through the process, answer your questions, and show how your old tech can make a real difference to help WA communities doing it tough.</p>
                <div class="text-center mb-5 mb-lg-6">
                    <a href="/contactus" class="rw-btn-gold">Donate</a>
                </div>
                <h2 class="rw-consultation-steps-title mb-4 text-center">One click, three steps, genuine impact!</h2>
                <div class="rw-consultation-steps text-start">
                    <p class="rw-consultation-step"><strong>01 Pick up.</strong> We collect your unused laptops, tablets, PCs and other digital gear.</p>
                    <p class="rw-consultation-step"><strong>02 Wipe clean.</strong> All data securely erased, ready for a fresh start.</p>
                    <p class="rw-consultation-step"><strong>03 Pay it forward.</strong> We donate the devices to those who need them most.</p>
                </div>
            </div>
        </section>
    </template>

    <!-- s_rw_steps — kept for Website Builder; homepage uses merged consultation block -->
    <template id="s_rw_steps" name="Re-Ware Three Steps">
        <section class="s_rw_steps rw-section rw-bg-image rw-bg-consultation" data-name="Re-Ware Three Steps" data-snippet="s_rw_steps">
            <div class="container rw-container-narrow position-relative">
                <h2 class="rw-consultation-steps-title mb-4 text-center">One click, three steps, genuine impact!</h2>
                <div class="rw-consultation-steps text-start">
                    <p class="rw-consultation-step"><strong>01 Pick up.</strong> We collect your unused laptops, tablets, PCs and other digital gear.</p>
                    <p class="rw-consultation-step"><strong>02 Wipe clean.</strong> All data securely erased, ready for a fresh start.</p>
                    <p class="rw-consultation-step"><strong>03 Pay it forward.</strong> We donate the devices to those who need them most.</p>
                </div>
            </div>
        </section>
    </template>

    <!-- s_rw_why — centred white card sitting on the photo background (matches reware-project.com) -->
    <template id="s_rw_why" name="Re-Ware Why">
        <section class="s_rw_why rw-section rw-bg-image rw-bg-why" data-name="Re-Ware Why" data-snippet="s_rw_why">
            <div class="container position-relative">
                <div class="rw-why-card text-center mx-auto">
                    <h2 class="mb-4">Why it matters.</h2>
                    <p class="mb-3 rw-why-lead">Less waste. Less risk. More responsible use of the tech you already own.</p>
                    <p class="mb-3 rw-why-body">The Re-Ware project is a sustainable model which supports a range of economic benefits that help address digital poverty in our society.</p>
                    <p class="mb-4 rw-why-body">Re-Ware refurbishes suitable devices and donates them to Western Australians experiencing digital poverty — including lower-income individuals and families, people that are displaced, people with disabilities, justice programs, and to support women and children rebuilding after domestic violence who need safe digital access.</p>
                    <div class="rw-why-rrr mb-4">
                        <p class="rw-why-rrr-line"><strong>R E P A I R .</strong></p>
                        <p class="rw-why-rrr-line"><strong>R E P U R P O S E .</strong></p>
                        <p class="rw-why-rrr-line"><strong>R E U S E .</strong></p>
                    </div>
                    <a href="/our-why" class="rw-btn-outline-dark">Learn more</a>
                </div>
            </div>
        </section>
    </template>

    <!-- s_rw_rrr -->
    <template id="s_rw_rrr" name="Re-Ware RRR Strip">
        <section class="s_rw_rrr rw-section rw-bg-dark rw-rrr text-center" data-name="Re-Ware RRR Strip" data-snippet="s_rw_rrr">
            <div class="container">
                <p class="rw-rrr-line">R E P A I R .</p>
                <p class="rw-rrr-line">R E P U R P O S E .</p>
                <p class="rw-rrr-line">R E U S E .</p>
            </div>
        </section>
    </template>

    <!-- s_rw_newsletter — Follow our journey block from reware-project.com.
         Stacked single-column layout on charcoal: heading + copy centered,
         then rounded First Name / Last Name / Email inputs, finally the
         gold JOIN US! button. -->
    <template id="s_rw_newsletter" name="Re-Ware Newsletter">
        <section class="s_rw_newsletter rw-section rw-bg-dark" data-name="Re-Ware Newsletter" data-snippet="s_rw_newsletter">
            <div class="container rw-container-narrow text-center">
                <h2 class="rw-newsletter-title mb-2">Follow our journey.</h2>
                <p class="rw-newsletter-tagline mb-3">AND be part of the change!</p>
                <p class="rw-newsletter-body mb-4">Subscribe for stories, insights, and ways to help us divert e-waste and support communities &#8212; straight to your inbox.</p>

                <form class="rw-newsletter rw-form mx-auto js_rw_newsletter_form"
                      action="/quote_manage_ui/newsletter/subscribe"
                      method="post"
                      data-submit-label="Join us!"
                      data-submitting-label="Submitting…"
                      novalidate="novalidate">
                    <div class="row g-3 text-start">
                        <div class="col-sm-6">
                            <label class="form-label" for="rw_nl_first_name">First Name <span class="rw-required">(required)</span></label>
                            <input id="rw_nl_first_name" type="text" name="first_name" class="form-control" autocomplete="given-name" required="required"/>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="rw_nl_last_name">Last Name <span class="rw-required">(required)</span></label>
                            <input id="rw_nl_last_name" type="text" name="last_name" class="form-control" autocomplete="family-name" required="required"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="rw_nl_email">Email Address <span class="rw-required">(required)</span></label>
                            <input id="rw_nl_email" type="email" name="email" class="form-control" autocomplete="email" required="required"/>
                        </div>
                    </div>
                    <button type="submit" class="rw-btn-gold rw-newsletter-submit mt-4">Join us!</button>
                    <div class="rw-newsletter-status mt-3" role="status" aria-live="polite"/>
                </form>
            </div>
        </section>
    </template>

    <!-- s_rw_categories -->
    <template id="s_rw_categories" name="Re-Ware Categories">
        <section class="s_rw_categories rw-section rw-bg-cream-soft" data-name="Re-Ware Categories" data-snippet="s_rw_categories">
            <div class="container">
                <div class="d-flex flex-wrap align-items-end justify-content-between mb-4 gap-3">
                    <div>
                        <p class="rw-eyebrow mb-2">Catalogue access</p>
                        <h2 class="mb-0">Browse refurbished categories</h2>
                    </div>
                    <a href="/shop" class="rw-btn-outline-dark">View catalogue</a>
                </div>
                <div class="row g-3 g-md-4">
                    <!-- request is unbound when the Editor renders snippet
                         thumbnails or t-snippet previews, so always guard
                         data lookups; without the guard the WHOLE snippet
                         panel rendering aborts and zero Re-Ware tiles show
                         up in the Builder. -->
                    <t t-set="home_categories" t-value="(request.env['product.public.category'].search([('parent_id', '=', False), ('product_tmpl_ids.website_published', '=', True), ('product_tmpl_ids.sale_ok', '=', True)], limit=16, order='sequence, name, id')) if (request and request.env) else []"/>
                    <t t-foreach="home_categories" t-as="h_cat">
                        <t t-set="_home_cat_cnt" t-value="h_cat.sudo()._rw_website_stock_units()"/>
                        <div class="col-6 col-md-3">
                            <a t-attf-href="/shop/category/#{slug(h_cat)}" class="text-decoration-none text-dark">
                                <div class="qm-comsol-cat-tile qm-comsol-home-cat-tile h-100 d-flex flex-column align-items-center justify-content-center text-center">
                                    <div class="mb-2">
                                        <t t-if="h_cat.image_128">
                                            <img t-attf-src="/web/image/product.public.category/#{h_cat.id}/image_128" class="img-fluid" style="max-height: 64px; width: auto;"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-tag fs-1" style="color: var(--rw-gold);"/>
                                        </t>
                                    </div>
                                    <p class="fw-bold mb-0" t-field="h_cat.name"/>
                                    <p class="small mb-0" style="color: var(--rw-text-muted);"><t t-esc="_home_cat_cnt"/> in stock</p>
                                </div>
                            </a>
                        </div>
                    </t>
                    <!-- Placeholder shown only inside the Editor preview
                         where the live category list isn't reachable. -->
                    <t t-if="not home_categories">
                        <div class="col-6 col-md-3"><div class="qm-comsol-cat-tile qm-comsol-home-cat-tile h-100 d-flex flex-column align-items-center justify-content-center text-center"><div class="mb-2"><i class="fa fa-tag fs-1" style="color: var(--rw-gold);"/></div><p class="fw-bold mb-0">Laptops</p><p class="small mb-0" style="color: var(--rw-text-muted);">— products</p></div></div>
                        <div class="col-6 col-md-3"><div class="qm-comsol-cat-tile qm-comsol-home-cat-tile h-100 d-flex flex-column align-items-center justify-content-center text-center"><div class="mb-2"><i class="fa fa-tag fs-1" style="color: var(--rw-gold);"/></div><p class="fw-bold mb-0">Monitors</p><p class="small mb-0" style="color: var(--rw-text-muted);">— products</p></div></div>
                        <div class="col-6 col-md-3"><div class="qm-comsol-cat-tile qm-comsol-home-cat-tile h-100 d-flex flex-column align-items-center justify-content-center text-center"><div class="mb-2"><i class="fa fa-tag fs-1" style="color: var(--rw-gold);"/></div><p class="fw-bold mb-0">Docks</p><p class="small mb-0" style="color: var(--rw-text-muted);">— products</p></div></div>
                        <div class="col-6 col-md-3"><div class="qm-comsol-cat-tile qm-comsol-home-cat-tile h-100 d-flex flex-column align-items-center justify-content-center text-center"><div class="mb-2"><i class="fa fa-tag fs-1" style="color: var(--rw-gold);"/></div><p class="fw-bold mb-0">Accessories</p><p class="small mb-0" style="color: var(--rw-text-muted);">— products</p></div></div>
                    </t>
                </div>
            </div>
        </section>
    </template>

    <!-- ============================================================
         Register snippets to the Website Editor panel
         (appears under "Structure" group, drag onto any page)
         ============================================================ -->
    <template id="rw_snippets_register" inherit_id="website.snippets" name="Re-Ware Snippets Register">
        <xpath expr="//div[@id='snippet_structure']//div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="quote_manage_ui.s_rw_hero" string="Re-Ware Hero"
               t-thumbnail="/quote_manage_ui/static/src/img/snippets/s_rw_hero.svg"/>
            <t t-snippet="quote_manage_ui.s_rw_page_hero" string="Re-Ware Page Hero"
               t-thumbnail="/quote_manage_ui/static/src/img/snippets/s_rw_page_hero.svg"/>
            <t t-snippet="quote_manage_ui.s_rw_services" string="Re-Ware Services"
               t-thumbnail="/quote_manage_ui/static/src/img/snippets/s_rw_services.svg"/>
            <t t-snippet="quote_manage_ui.s_rw_consultation" string="Re-Ware Consultation"
               t-thumbnail="/quote_manage_ui/static/src/img/snippets/s_rw_consultation.svg"/>
            <t t-snippet="quote_manage_ui.s_rw_steps" string="Re-Ware Three Steps"
               t-thumbnail="/quote_manage_ui/static/src/img/snippets/s_rw_steps.svg"/>
            <t t-snippet="quote_manage_ui.s_rw_why" string="Re-Ware Why"
               t-thumbnail="/quote_manage_ui/static/src/img/snippets/s_rw_why.svg"/>
            <t t-snippet="quote_manage_ui.s_rw_rrr" string="Re-Ware RRR Strip"
               t-thumbnail="/quote_manage_ui/static/src/img/snippets/s_rw_rrr.svg"/>
            <t t-snippet="quote_manage_ui.s_rw_newsletter" string="Re-Ware Newsletter"
               t-thumbnail="/quote_manage_ui/static/src/img/snippets/s_rw_newsletter.svg"/>
            <t t-snippet="quote_manage_ui.s_rw_categories" string="Re-Ware Categories"
               t-thumbnail="/quote_manage_ui/static/src/img/snippets/s_rw_categories.svg"/>
        </xpath>
    </template>

    <!-- ============================================================
         Snippet options (color variant + section toggle)
         User clicks any Re-Ware section -> "Re-Ware background"
         dropdown shows up in the right-hand options panel
         ============================================================ -->
    <template id="rw_snippets_options" inherit_id="website.snippet_options" name="Re-Ware Snippet Options">
        <xpath expr="." position="inside">
            <!-- Hero carousel sits inside .container/.row, not as a direct child of
                 <section>. Stock Odoo Carousel options use section > .carousel, so
                 Add slide never binds and spins forever. Target the nested carousel. -->
            <div data-js="Carousel"
                 data-selector="section.s_rw_hero"
                 data-target=".s_carousel.carousel">
                <we-row string="Slide">
                    <we-button data-add-slide="true" data-no-preview="true" class="o_we_bg_brand_primary">Add Slide</we-button>
                </we-row>
                <we-select string="Transition">
                    <we-button data-select-class="slide">Slide</we-button>
                    <we-button data-select-class="carousel-fade slide">Fade</we-button>
                    <we-divider/>
                    <we-button data-select-class="">None</we-button>
                </we-select>
                <we-input string="Speed"
                          data-select-data-attribute="0s" data-attribute-name="bsInterval"
                          data-unit="s" data-save-unit="ms" data-step="0.1"/>
            </div>
            <div data-selector="section[data-snippet^='s_rw_']">
                <we-select string="Re-Ware background">
                    <we-button data-select-class="">Default</we-button>
                    <we-button data-select-class="rw-bg-cream">Cream</we-button>
                    <we-button data-select-class="rw-bg-cream-soft">Cream soft</we-button>
                    <we-button data-select-class="rw-bg-cream-deep">Cream deep</we-button>
                    <we-button data-select-class="rw-bg-dark">Dark</we-button>
                </we-select>
                <we-select string="Section spacing">
                    <we-button data-select-class="">Standard</we-button>
                    <we-button data-select-class="rw-section-sm">Compact</we-button>
                    <we-button data-select-class="rw-section-lg">Tall</we-button>
                </we-select>
            </div>
        </xpath>
    </template>
</odoo>
