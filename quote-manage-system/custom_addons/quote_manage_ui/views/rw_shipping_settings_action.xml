<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated form so keys are easy to find (not buried in Sales settings). -->
    <record id="view_rw_shipping_api_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.rw.shipping.api</field>
        <field name="model">res.config.settings</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="AusPost &amp; CartonPilot API" class="oe_form_configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>Re-Ware shipping API</h1>
                        <p class="text-muted">
                            Cartonization (CartonPilot) + Australia Post PAC rates at checkout.
                            Keys are stored server-side only.
                        </p>
                    </div>
                    <group>
                        <field name="rw_shipping_pipeline_enabled"/>
                    </group>
                    <group string="Australia Post" invisible="not rw_shipping_pipeline_enabled">
                        <field name="rw_auspost_from_postcode" placeholder="e.g. 2000"/>
                        <field name="rw_auspost_service_code" placeholder="AUS_PARCEL_REGULAR"/>
                        <field name="rw_auspost_auth_key" password="True"/>
                    </group>
                    <group string="CartonPilot (optional)" invisible="not rw_shipping_pipeline_enabled">
                        <field name="rw_cartonpilot_api_key" password="True"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" name="execute" type="object" class="btn-primary" data-hotkey="s"/>
                    <button string="Cancel" special="cancel" data-hotkey="z" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rw_shipping_api_settings" model="ir.actions.act_window">
        <field name="name">AusPost &amp; CartonPilot API</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_rw_shipping_api_settings_form"/>
    </record>

    <menuitem id="menu_rw_shipping_api_settings"
              name="AusPost &amp; CartonPilot API"
              parent="sale.menu_sales_config"
              action="action_rw_shipping_api_settings"
              sequence="35"
              groups="sales_team.group_sale_manager"/>

</odoo>
