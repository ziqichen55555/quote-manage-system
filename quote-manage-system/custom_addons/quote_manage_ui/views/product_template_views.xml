<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_quote_dedupe_attributes" model="ir.ui.view">
        <field name="name">product.template.form.quote.dedupe.attributes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attribute_line_ids']" position="before">
                <div class="alert alert-warning mb-3" role="alert" groups="product.group_product_variant">
                    <span class="me-2">If you see the same attribute repeated many times with identical values, merge duplicates safely:</span>
                    <button name="action_quote_deduplicate_attribute_lines"
                            string="Deduplicate attribute lines"
                            type="object"
                            class="btn btn-sm btn-secondary"
                            confirm="This removes duplicate rows that share the same attribute and the same value set. Odoo may regenerate variants. Continue?"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Standard Odoo hides publish behind a small "Go to Website" stat button
         (only when sale_ok). Show an explicit toggle on the product form. -->
    <record id="product_template_form_quote_website_published" model="ir.ui.view">
        <field name="name">product.template.form.quote.website.published</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex ms-3" invisible="not sale_ok">
                    <field name="is_published" widget="boolean_toggle"/>
                    <label for="is_published" string="Published on Website" class="ms-2"/>
                </span>
            </xpath>
            <xpath expr="//group[@name='shop']" position="inside">
                <field name="is_published" string="Published on Website" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <!-- Shop filter category on General Information (next to Product Category).
         website_sale only puts public_categ_ids in the Sales → eCommerce Shop
         group, which is easy to miss when adding products by hand. -->
    <record id="product_template_form_shop_filter_category" model="ir.ui.view">
        <field name="name">product.template.form.shop.filter.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']/field[@name='categ_id']" position="after">
                <field name="public_categ_ids"
                       widget="many2many_tags"
                       string="Shop Filter Category"
                       placeholder="e.g. Laptops, Desktops…"
                       options="{'no_create': True, 'no_quick_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_shop_filter_category" model="ir.ui.view">
        <field name="name">product.template.tree.shop.filter.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="public_categ_ids"
                       widget="many2many_tags"
                       string="Shop Filter Category"
                       optional="show"/>
            </field>
        </field>
    </record>

    <record id="product_template_search_shop_filter_category" model="ir.ui.view">
        <field name="name">product.template.search.shop.filter.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="public_categ_ids" string="Shop Filter Category"/>
            </field>
        </field>
    </record>

    <record id="product_template_form_shop_group_categ_label" model="ir.ui.view">
        <field name="name">product.template.form.shop.group.categ.label</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='shop']/field[@name='public_categ_ids']" position="attributes">
                <attribute name="string">Shop Filter Category</attribute>
            </xpath>
        </field>
    </record>
</odoo>
