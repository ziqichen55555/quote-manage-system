<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_quote_dedupe_attributes" model="ir.ui.view">
        <field name="name">product.template.form.quote.dedupe.attributes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attribute_line_ids']" position="before">
                <div class="alert alert-warning mb-3" role="alert" groups="product.group_product_variant">
                    <span class="me-2">If you see the same attribute repeated many times with identical values, merge duplicates safely:</span>
                    <button name="action_quote_deduplicate_attribute_lines"
                            string="Deduplicate attribute lines"
                            type="object"
                            class="btn btn-sm btn-secondary"
                            confirm="This removes duplicate rows that share the same attribute and the same value set. Odoo may regenerate variants. Continue?"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Standard Odoo hides publish behind a small "Go to Website" stat button
         (only when sale_ok). Show an explicit toggle on the product form. -->
    <record id="product_template_form_quote_website_published" model="ir.ui.view">
        <field name="name">product.template.form.quote.website.published</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex ms-3" invisible="not sale_ok">
                    <field name="is_published" widget="boolean_toggle"/>
                    <label for="is_published" string="Published on Website" class="ms-2"/>
                </span>
            </xpath>
            <xpath expr="//group[@name='shop']" position="inside">
                <field name="is_published" string="Published on Website" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
