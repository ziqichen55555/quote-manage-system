<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Larger logo in report header (all external layouts). -->
    <template id="external_layout_standard_reware_logo"
              inherit_id="web.external_layout_standard">
        <xpath expr="//div[hasclass('col-3')][hasclass('mb4')]/img" position="attributes">
            <attribute name="class">o_reware_report_logo</attribute>
            <attribute name="style">max-height: 120px; width: 100%; max-width: 200px; object-fit: contain; object-position: left top;</attribute>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="inside">
            <li t-if="company.vat" class="mt-1 reware-company-abn">
                <t t-if="company.country_id.code == 'AU'">ABN</t>
                <t t-else=""><t t-esc="company.country_id.vat_label or 'Tax ID'"/></t>:
                <span t-field="company.vat"/>
            </li>
        </xpath>
    </template>

    <template id="external_layout_boxed_reware_logo"
              inherit_id="web.external_layout_boxed">
        <xpath expr="//div[hasclass('o_boxed_header')]//div[hasclass('col-6')][1]/img" position="attributes">
            <attribute name="class">o_reware_report_logo</attribute>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="inside">
            <li t-if="company.vat" class="mt-1 reware-company-abn">
                <t t-if="company.country_id.code == 'AU'">ABN</t>
                <t t-else=""><t t-esc="company.country_id.vat_label or 'Tax ID'"/></t>:
                <span t-field="company.vat"/>
            </li>
        </xpath>
    </template>

    <template id="external_layout_bold_reware_logo"
              inherit_id="web.external_layout_bold">
        <xpath expr="//div[hasclass('o_clean_header')]//div[hasclass('col-6')][1]" position="attributes">
            <attribute name="class">col-7 o_reware_logo_col</attribute>
        </xpath>
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="class">col-4 offset-1 o_reware_from_col text-end</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_clean_header')]//div[hasclass('col-7')][1]/img" position="attributes">
            <attribute name="class">o_reware_report_logo</attribute>
            <attribute name="style">max-height: 220px; width: 100%; max-width: 420px; object-fit: contain; object-position: left top;</attribute>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="inside">
            <li class="mb-1 reware-address-label"><strong>From</strong></li>
            <li t-if="company.vat" class="mt-1 reware-company-abn">
                <t t-if="company.country_id.code == 'AU'">ABN</t>
                <t t-else=""><t t-esc="company.country_id.vat_label or 'Tax ID'"/></t>:
                <span t-field="company.vat"/>
            </li>
        </xpath>
    </template>

    <template id="external_layout_striped_reware_logo"
              inherit_id="web.external_layout_striped">
        <xpath expr="//div[hasclass('o_background_header')]/img[hasclass('float-start')]" position="attributes">
            <attribute name="class">float-start o_reware_report_logo</attribute>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="inside">
            <li t-if="company.vat" class="mt-1 reware-company-abn">
                <t t-if="company.country_id.code == 'AU'">ABN</t>
                <t t-else=""><t t-esc="company.country_id.vat_label or 'Tax ID'"/></t>:
                <span t-field="company.vat"/>
            </li>
        </xpath>
    </template>

    <!-- Bill To label on customer address (invoice body, right column). -->
    <template id="address_layout_bill_to"
              inherit_id="web.address_layout">
        <xpath expr="//div[@name='address']/t" position="before">
            <strong class="d-block mb-1 reware-address-label">Bill To</strong>
        </xpath>
    </template>

    <!-- Append Co-Creative IT payment details (bank / BSB / account) to customer invoices.
         Data comes from the invoice Recipient Bank, or the company's first bank account. -->
    <template id="report_invoice_document_payment_details"
              inherit_id="account.report_invoice_document"
              name="Quote Manage UI Invoice Payment Details">
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="o.move_type == 'out_invoice' and o.company_id.vat"
                 class="col-auto col-3 mw-100 mb-2"
                 name="quote_manage_ui_company_abn">
                <strong>
                    <t t-if="o.company_id.country_id.code == 'AU'">ABN</t>
                    <t t-else=""><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/></t>:
                </strong>
                <span t-field="o.company_id.vat"/>
            </div>
        </xpath>
        <!-- Force totals block to finish before payment / terms (wkhtmltopdf float fix). -->
        <xpath expr="//div[@id='right-elements']" position="after">
            <div class="o_reware_invoice_totals_clear" style="clear: both; width: 100%; height: 0; line-height: 0;"/>
        </xpath>
        <xpath expr="//div[@id='right-elements']" position="attributes">
            <attribute name="style">float: none !important; display: block !important; margin-left: auto; width: 42%;</attribute>
        </xpath>
        <xpath expr="//div[@id='right-elements']" position="replace">
            <div id="right-elements"
                 t-attf-class="#{'col-5' if report_type != 'html' else 'col-12 col-md-5'} ms-auto"
                 style="display: block; float: none; margin-left: auto;">
                <div id="total" class="clearfix row">
                    <div class="ms-auto">
                        <table class="table table-sm table-borderless avoid-page-break-inside">
                            <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                            <t t-call="account.document_tax_totals"/>
                            <t t-if="print_with_payments">
                                <t t-if="o.payment_state != 'invoicing_legacy'">
                                    <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                    <t t-foreach="payments_vals" t-as="payment_vals">
                                        <tr t-if="payment_vals['is_exchange'] == 0">
                                            <td>
                                                <i class="oe_form_field text-end oe_payment_label">Paid on <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/></i>
                                            </td>
                                            <td class="text-end">
                                                <span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="len(payments_vals) > 0">
                                        <tr class="border-black fw-bold">
                                            <td>Amount Due</td>
                                            <td class="text-end">
                                                <span t-field="o.amount_residual"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        </table>
                    </div>
                </div>
                <div class="mb-2">
                    <p class="text-end lh-sm" t-if="o.company_id.display_invoice_amount_total_words">
                        Total amount in words: <br/>
                        <small class="text-muted lh-sm"><span t-field="o.amount_total_words"/></small>
                    </p>
                </div>
                <t t-call="account.document_tax_totals_company_currency_template"/>
            </div>
        </xpath>
        <xpath expr="//div[@id='payment_term']" position="attributes">
            <attribute name="class" add="o_reware_invoice_payment_block"/>
            <attribute name="style">clear: both !important; width: 100%; display: block; padding-top: 12px; margin-top: 8px; border-top: 1px solid #dee2e6;</attribute>
        </xpath>
        <xpath expr="//div[@name='comment']" position="before">
            <t t-set="company_bank" t-value="o.partner_bank_id or o.company_id.bank_ids[:1]"/>
            <div class="mb-3"
                 t-if="o.move_type == 'out_invoice' and company_bank"
                 name="quote_manage_ui_payment_details">
                <strong>Payment Details</strong>
                <div t-if="company_bank.bank_id">
                    <span t-field="company_bank.bank_id.name"/>
                </div>
                <div t-if="company_bank.acc_holder_name">
                    Account Name: <span t-field="company_bank.acc_holder_name"/>
                </div>
                <div t-if="company_bank.aba_bsb">
                    BSB: <span t-field="company_bank.aba_bsb"/>
                </div>
                <div t-if="company_bank.acc_number">
                    Account Number: <span t-field="company_bank.acc_number"/>
                </div>
            </div>
        </xpath>
    </template>

    <!-- v144 hard layout fix:
         enforce totals block + payment block vertical stacking in PDF -->
    <template id="report_invoice_document_layout_stack_fix_v144"
              inherit_id="account.report_invoice_document"
              priority="95"
              name="Quote Manage UI Invoice Layout Stack Fix v144">
        <xpath expr="//div[@id='right-elements']" position="attributes">
            <attribute name="t-attf-class">#{'col-5' if report_type != 'html' else 'col-12 col-md-5'} ms-auto</attribute>
            <attribute name="style">display:block; float:none !important; clear:none; margin-left:auto;</attribute>
        </xpath>
        <xpath expr="//div[@id='payment_term']" position="attributes">
            <attribute name="style">display:block; clear:both !important; width:100%; margin-top:10px; padding-top:12px; border-top:1px solid #dee2e6;</attribute>
        </xpath>
    </template>
</odoo>
