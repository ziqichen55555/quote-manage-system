<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_rw_shipping_dims" model="ir.ui.view">
        <field name="name">product.template.form.rw.shipping.dims</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
                <label for="rw_ship_length_cm" string="Pack size (cm, L×W×H)"/>
                <div class="o_row">
                    <field name="rw_ship_length_cm" placeholder="L"/>
                    <span>×</span>
                    <field name="rw_ship_width_cm" placeholder="W"/>
                    <span>×</span>
                    <field name="rw_ship_height_cm" placeholder="H"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
