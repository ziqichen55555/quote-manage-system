<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Re-Ware Project — Front-end templates
         Visual reference: https://www.reware-project.com/
         Design system lives in: static/src/scss/style.scss (.rw-* classes)
         ============================================================ -->

    <!-- 1. Global layout: inject announcement bar + Re-Ware body class -->
    <template id="global_style_overrides" inherit_id="website.layout" name="Reware Global Styles">
        <xpath expr="//div[@id='wrapwrap']" position="before">
            <div class="rw-announcement" id="rw-announcement">
                <a href="/contactus">Book your data erasure now</a>
                <button type="button" class="rw-announcement-close" aria-label="Close" onclick="document.body.classList.add('rw-announcement-hidden')">&#215;</button>
            </div>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="class" add="rw-site" separator=" "/>
        </xpath>
    </template>

    <!-- 2. Menu records (Shop / Trade-in seeded; About / Services / Our Why / Partners
         created later, after their page records, so ref= resolves correctly.) -->
    <record id="menu_shop" model="website.menu">
        <field name="name">Shop</field>
        <field name="url">/shop</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">1</field>
    </record>

    <record id="menu_trade_in" model="website.menu">
        <field name="name">Trade-in</field>
        <field name="url">/trade-in</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">2</field>
    </record>

    <!-- 3. Header — minimal nav (Re-Ware Project · About · Our Why · Contact · DONATE NOW) -->
    <template id="template_header_default_force" inherit_id="website.template_header_default" name="Reware Header" priority="99">
        <xpath expr="//t[@t-call='website.navbar']" position="replace">
            <nav data-name="Navbar" aria-label="Main" class="navbar navbar-expand-lg rw-navbar rw-navbar-light">
                <div class="container">
                    <a href="/" class="rw-brand me-auto">Re-Ware Project</a>

                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#top_menu_collapse">
                        <span class="navbar-toggler-icon"/>
                    </button>

                    <div class="collapse navbar-collapse flex-grow-0" id="top_menu_collapse">
                        <ul class="navbar-nav align-items-lg-center gap-lg-2">
                            <t t-foreach="website.menu_id.child_id.exists()" t-as="submenu">
                                <t t-if="submenu.url not in ('/contactus', '/partners', '/partners-10')">
                                    <t t-call="website.submenu">
                                        <t t-set="item_class" t-valuef="nav-item"/>
                                        <t t-set="link_class" t-valuef="nav-link"/>
                                    </t>
                                </t>
                            </t>
                            <li class="nav-item ms-lg-2">
                                <a href="/contactus" class="rw-btn-gold">Donate now</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a href="/shop/cart" class="nav-link position-relative" aria-label="Cart">
                                    <i class="fa fa-shopping-cart"/>
                                </a>
                            </li>
                            <t t-call="portal.placeholder_user_sign_in">
                                <t t-set="_link_class" t-valuef="nav-link"/>
                            </t>
                            <t t-call="portal.user_dropdown">
                                <t t-set="_user_name" t-value="True"/>
                                <t t-set="_link_class" t-valuef="nav-link"/>
                            </t>
                        </ul>
                    </div>
                </div>
            </nav>
        </xpath>
    </template>

    <!-- 4. Footer — single reusable QWeb t-call, also replaces website.layout's footer -->
    <template id="rw_footer_block" name="Reware Footer Block">
        <footer class="rw-footer">
            <div class="container">
                <h2 class="rw-footer-title">Re-Ware, designed by Co-Creative IT.</h2>
                <div class="row justify-content-center text-center g-4">
                    <div class="col-md-4">
                        <h4>Contact</h4>
                        <p class="mb-1"><a href="mailto:re-ware@cocreativeit.com">re-ware@cocreativeit.com</a></p>
                        <p class="mb-0"><a href="tel:0499909302">0499 909 302</a></p>
                    </div>
                    <div class="col-md-4">
                        <h4>Location</h4>
                        <p class="mb-0">102 Edward St, Perth, Western Australia</p>
                    </div>
                </div>
                <div class="rw-footer-bottom text-center">
                    <a href="https://www.cocreativeit.com/" target="_blank" rel="noopener noreferrer">Co-Creative IT</a>
                </div>
            </div>
        </footer>
    </template>

    <template id="rw_footer_override" inherit_id="website.layout" name="Reware Footer Override" priority="99">
        <xpath expr="//footer" position="replace">
            <t t-call="quote_manage_ui.rw_footer_block"/>
        </xpath>
    </template>

    <!-- 5. Legacy alias: keep old t-call references working by forwarding to
         the new s_rw_newsletter snippet (snippets.xml). Page archs use the
         new ID directly; this only catches stale COW copies from earlier
         versions of the module. -->
    <template id="rw_newsletter_block" name="Reware Newsletter (alias)">
        <t t-call="quote_manage_ui.s_rw_newsletter"/>
    </template>

    <!-- ============================================================
         6. Shop layout customisations (cream surface + Re-Ware tiles)
         ============================================================ -->
    <template id="reware_products" inherit_id="website_sale.products" name="Reware Shop Layout" priority="10">
        <xpath expr="//t[@t-set='opt_wsale_categories']" position="replace">
            <t t-set="opt_wsale_categories" t-value="True"/>
        </xpath>
        <xpath expr="//t[@t-set='hasLeftColumn']" position="replace">
            <t t-set="hasLeftColumn" t-value="True"/>
        </xpath>
        <xpath expr="//t[@t-set='opt_wsale_categories_top']" position="replace">
            <t t-set="opt_wsale_categories_top" t-value="False"/>
        </xpath>

        <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="before">
            <div class="row">
                <div class="col-12 mb-4">
                    <div class="qm-comsol-shop-hero p-4 p-lg-5">
                        <p class="rw-eyebrow mb-2">Product catalogue</p>
                        <div class="row align-items-start g-4 mb-0 mb-lg-4">
                            <div class="col-lg-7">
                                <h2 class="fw-bold mb-3">Re-Ware certified hardware</h2>
                                <p class="mb-0" style="max-width: 36rem; color: var(--rw-text-soft); line-height: 1.6;">Professionally refurbished devices with consistent grading, documented testing, and warranty-backed delivery.</p>
                            </div>
                            <div class="col-lg-5">
                                <ul class="list-unstyled qm-comsol-value-list mb-0 small">
                                    <li class="d-flex mb-2"><span class="qm-comsol-bullet me-2 flex-shrink-0"/><span>End-to-end quality workflow from intake to shipment</span></li>
                                    <li class="d-flex mb-2"><span class="qm-comsol-bullet me-2 flex-shrink-0"/><span>Transparent grades and functional checks</span></li>
                                    <li class="d-flex mb-2"><span class="qm-comsol-bullet me-2 flex-shrink-0"/><span>12-month warranty and easy returns</span></li>
                                    <li class="d-flex"><span class="qm-comsol-bullet me-2 flex-shrink-0"/><span>Fast, tracked logistics</span></li>
                                </ul>
                            </div>
                        </div>
                        <div class="row g-3 text-center justify-content-start border-top pt-4 mt-2">
                            <t t-set="top_categories" t-value="list(categories) if categories else []"/>
                            <t t-foreach="top_categories" t-as="t_cat">
                                <t t-set="_cat_cnt" t-value="request.env['product.template'].sudo().search_count([('public_categ_ids', 'in', [t_cat.id]), ('website_published', '=', True), ('sale_ok', '=', True)])"/>
                                <div class="col-3 col-md-2">
                                    <a t-attf-href="/shop/category/#{slug(t_cat)}" class="text-decoration-none text-dark">
                                        <div class="qm-comsol-cat-tile p-3 h-100 d-flex flex-column align-items-center justify-content-center">
                                            <t t-if="t_cat.image_128">
                                                <img t-attf-src="/web/image/product.public.category/#{t_cat.id}/image_128" class="img-fluid mb-1" style="max-height: 40px; width: auto;"/>
                                            </t>
                                            <t t-else="">
                                                <i t-if="t_cat.name == 'Laptops'" class="fa fa-laptop fs-3 mb-1" style="color: var(--rw-gold);"/>
                                                <i t-else="" class="fa fa-tag fs-3 mb-1" style="color: var(--rw-gold);"/>
                                            </t>
                                            <div class="small fw-bold mt-auto text-center" t-field="t_cat.name"/>
                                            <div class="small" style="color: var(--rw-text-muted);"><t t-esc="_cat_cnt"/> in stock</div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="reware_products_item" inherit_id="website_sale.products_item" name="Reware Product Item" priority="10">
        <xpath expr="//div[hasclass('oe_product_image')]" position="inside">
            <div class="position-absolute top-0 start-0 p-2 o_not_editable">
                <span class="reware-badge">Certified</span>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_information')]" position="attributes">
            <attribute name="class" add="p-3 border-top-0" separator=" "/>
        </xpath>
        <xpath expr="//h6[hasclass('o_wsale_products_item_title')]" position="after">
            <div class="qm-shop-spec-tags d-flex flex-wrap gap-1 mb-2 small" t-if="product.valid_product_template_attribute_line_ids">
                <t t-foreach="product.valid_product_template_attribute_line_ids" t-as="spec_line">
                    <span t-if="spec_line.value_ids" class="badge rounded-pill fw-normal">
                        <span t-field="spec_line.attribute_id.name"/>: <t t-esc="', '.join(spec_line.value_ids.mapped('name'))"/>
                    </span>
                </t>
            </div>
            <div class="qm-shop-stock small mb-1" t-if="product.type == 'product'">
                <span class="fw-semibold">Stock: </span><t t-esc="int(round(product.sudo().qty_available))"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('product_price')]" position="inside">
            <t t-set="template_price_vals" t-value="get_product_prices(product)"/>
            <t t-if="'base_price' in template_price_vals and (template_price_vals['base_price'] &gt; template_price_vals['price_reduce']) and template_price_vals['base_price'] &gt; 0">
                <span class="price-save-badge ms-2">Save <t t-esc="int((1 - template_price_vals['price_reduce'] / template_price_vals['base_price']) * 100)"/>%</span>
            </t>
        </xpath>
    </template>

    <template id="reware_product_detail" inherit_id="website_sale.product" name="Reware Product Detail" priority="10">
        <xpath expr="//div[@id='add_to_cart_wrap']" position="before">
            <p class="small mb-2 o_not_editable" style="color: var(--rw-text-muted);" t-if="product.type == 'product'">
                <span class="fw-semibold" style="color: var(--rw-text);">Stock on hand: </span><t t-esc="int(round(product.sudo().qty_available))"/>
            </p>
        </xpath>
        <xpath expr="//div[@id='add_to_cart_wrap']" position="after">
            <div class="mt-4 p-4 bg-white border o_not_editable qm-comsol-detail-panel">
                <p class="rw-eyebrow mb-2">Purchase confidence</p>
                <h6 class="fw-bold mb-3">Included with every certified device</h6>
                <div class="row g-3 small">
                    <div class="col-sm-6 d-flex align-items-start"><span class="qm-comsol-bullet me-2 mt-1 flex-shrink-0"/><span>12-month limited warranty</span></div>
                    <div class="col-sm-6 d-flex align-items-start"><span class="qm-comsol-bullet me-2 mt-1 flex-shrink-0"/><span>30-day returns where applicable</span></div>
                    <div class="col-sm-6 d-flex align-items-start"><span class="qm-comsol-bullet me-2 mt-1 flex-shrink-0"/><span>Professional refurbishment and grading</span></div>
                    <div class="col-sm-6 d-flex align-items-start"><span class="qm-comsol-bullet me-2 mt-1 flex-shrink-0"/><span>Lower environmental impact</span></div>
                </div>
            </div>
        </xpath>
        <xpath expr="//t[@t-call='website_sale.variants']" position="attributes">
            <attribute name="class" add="reware-configurator" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='add_to_cart_wrap']" position="attributes">
            <attribute name="class" replace="d-inline-flex align-items-center mb-2 me-auto"/>
        </xpath>
    </template>

    <!-- ============================================================
         7. Inline website.page records (data noupdate=1 — sync via
         model fn or version migration when arch is updated).
         ============================================================ -->
    <data noupdate="1">

    <!-- 7a. Trade-in -->
    <record id="trade_in_page" model="website.page" forcecreate="True">
        <field name="name">Trade-in</field>
        <field name="url">/trade-in</field>
        <field name="type">qweb</field>
        <field name="is_published">True</field>
        <field name="key">quote_manage_ui.trade_in_page</field>
        <field name="arch" type="xml">
            <t name="Trade-in" t-name="quote_manage_ui.trade_in_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty rw-site">
                        <section class="s_rw_page_hero rw-page-hero" data-name="Re-Ware Page Hero" data-snippet="s_rw_page_hero">
                            <div class="container">
                                <p class="rw-eyebrow mb-3">Trade-in</p>
                                <h1 class="mb-3">Trade in your old tech.</h1>
                                <p class="lead">Cash or store credit for your used devices — fast, secure, and good for the planet.</p>
                            </div>
                        </section>

                        <section class="s_rw_tradein_why rw-section rw-bg-cream-soft" data-name="Trade-in Why" data-snippet="s_rw_tradein_why">
                            <div class="container">
                                <div class="row align-items-center g-5">
                                    <div class="col-lg-6">
                                        <p class="rw-eyebrow mb-2">Why trade in</p>
                                        <h2 class="mb-4">Fighting digital poverty.</h2>
                                        <p style="color: var(--rw-text-soft); font-size: 1.05rem; line-height: 1.6;">Re-Ware plays a pivotal role fighting digital poverty across Western Australia by giving end-of-life devices a second life.</p>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="rw-card">
                                            <p class="rw-eyebrow mb-2">Drop-off point</p>
                                            <h3 class="mb-2">Co-Creative IT</h3>
                                            <p>102 Edward Street, Perth, Western Australia 6000</p>
                                            <div class="mt-2"><a href="/contactus" class="rw-btn-outline-dark">Get directions</a></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <t t-call="quote_manage_ui.s_rw_steps"/>

                        <t t-call="quote_manage_ui.s_rw_newsletter"/>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- 7b. Services -->
    <record id="services_page" model="website.page" forcecreate="True">
        <field name="name">Our Services</field>
        <field name="url">/services</field>
        <field name="type">qweb</field>
        <field name="is_published">True</field>
        <field name="key">quote_manage_ui.services_page</field>
        <field name="arch" type="xml">
            <t name="Services" t-name="quote_manage_ui.services_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty rw-site">
                        <section class="s_rw_page_hero rw-page-hero" data-name="Re-Ware Page Hero" data-snippet="s_rw_page_hero">
                            <div class="container">
                                <p class="rw-eyebrow mb-3">What we do</p>
                                <h1 class="mb-3">Our services.</h1>
                                <p class="lead">Creativity, integrity, innovation and vision — applied to every refurbishment and partnership.</p>
                            </div>
                        </section>

                        <section class="s_rw_service_grid rw-section rw-bg-cream-soft" data-name="Service Grid" data-snippet="s_rw_service_grid">
                            <div class="container">
                                <div class="row g-4">
                                    <div class="col-md-4"><div class="rw-card"><h3>Hardware</h3><p>Devices that fit current needs and grow with you, backed by full support.</p></div></div>
                                    <div class="col-md-4"><div class="rw-card"><h3>Software</h3><p>Cost-effective solutions that scale as your business evolves.</p></div></div>
                                    <div class="col-md-4"><div class="rw-card"><h3>Careware</h3><p>The unique ingredient that makes us — and your business — different.</p></div></div>
                                    <div class="col-md-4"><div class="rw-card"><h3>Re-ware</h3><p>E-waste collection and refurbishment to fight digital poverty across WA.</p><p class="mt-2 mb-0"><a href="/aboutus#reware-project" class="rw-btn-text">Read more</a></p></div></div>
                                    <div class="col-md-4"><div class="rw-card"><h3>Network security</h3><p>Cybercrime protection is our highest priority in managing your infrastructure.</p></div></div>
                                    <div class="col-md-4"><div class="rw-card"><h3>IT consulting</h3><p>We understand your business as intimately as you do.</p></div></div>
                                </div>
                            </div>
                        </section>

                        <t t-call="quote_manage_ui.s_rw_newsletter"/>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- 7c. About Us -->
    <record id="about_us_page" model="website.page" forcecreate="True">
        <field name="name">About Us</field>
        <field name="url">/aboutus</field>
        <field name="type">qweb</field>
        <field name="is_published">True</field>
        <field name="key">quote_manage_ui.about_us_page</field>
        <field name="arch" type="xml">
            <t name="About Us" t-name="quote_manage_ui.about_us_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty rw-site">
                        <section class="s_rw_split rw-section rw-bg-cream" data-name="Who we are" data-snippet="s_rw_split">
                            <div class="container">
                                <div class="row align-items-center g-5">
                                    <div class="col-lg-6">
                                        <h1 class="mb-3">Who we are.</h1>
                                        <p class="lead mb-4" style="font-size: 1.25rem; color: var(--rw-text);">Two friends, one practical idea — tech that builds community, not landfill.</p>
                                        <p style="color: var(--rw-text-soft); line-height: 1.65;">Louis and Drew built Re-Ware so everyone can access reliable technology without compromising the planet our kids will inherit.</p>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="rw-hero-image rw-hero-image-placeholder" style="min-height: 380px;"/>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section id="reware-project" class="s_rw_story rw-section rw-bg-cream-soft" data-name="Our story" data-snippet="s_rw_story">
                            <div class="container rw-container-narrow">
                                <p class="rw-eyebrow mb-2">Our story</p>
                                <h2 class="mb-4">Tech that respects people and the planet.</h2>
                                <p style="color: var(--rw-text-soft); line-height: 1.7; font-size: 1.05rem;">Louis runs Co-Creative IT, a family business that has worked across the tech space for years. Drew brings community-focused experience from technical roles across events, AV and installation. Together they created a straightforward way to give reliable devices a second life and donate them to people who need them.</p>
                            </div>
                        </section>

                        <section class="s_rw_howwework rw-section rw-bg-cream" data-name="How we work" data-snippet="s_rw_howwework">
                            <div class="container rw-container-narrow">
                                <p class="rw-eyebrow mb-2">How we work</p>
                                <h2 class="mb-4">Partnerships that keep devices in use.</h2>
                                <p style="color: var(--rw-text-soft); line-height: 1.7; font-size: 1.05rem;">Re-Ware partners with corporates, not-for-profits and community-minded organisations to build circular solutions. It is not charity and it is not corporate spin — just a better way to use what already exists.</p>
                                <div class="mt-4"><a href="/contactus" class="rw-btn-gold">Let's talk</a></div>
                            </div>
                        </section>

                        <t t-call="quote_manage_ui.s_rw_newsletter"/>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- 7d. Our Why -->
    <record id="our_why_page" model="website.page" forcecreate="True">
        <field name="name">Our Why</field>
        <field name="url">/our-why</field>
        <field name="type">qweb</field>
        <field name="is_published">True</field>
        <field name="key">quote_manage_ui.our_why_page</field>
        <field name="arch" type="xml">
            <t name="Our Why" t-name="quote_manage_ui.our_why_page">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty rw-site">
                        <section class="s_rw_page_hero rw-page-hero" data-name="Re-Ware Page Hero" data-snippet="s_rw_page_hero">
                            <div class="container">
                                <p class="rw-eyebrow mb-3">Our why</p>
                                <h1 class="mb-3">Why it matters.</h1>
                                <p class="lead">Less waste. Less risk. More responsible use of the tech we already own.</p>
                            </div>
                        </section>

                        <section class="s_rw_why_principles rw-section rw-bg-cream-soft" data-name="Why principles" data-snippet="s_rw_why_principles">
                            <div class="container">
                                <div class="row g-5 align-items-center">
                                    <div class="col-lg-7">
                                        <h2 class="mb-4">Digital access and environmental responsibility scale together.</h2>
                                        <p class="mb-3" style="color: var(--rw-text-soft); line-height: 1.65;">The Re-Ware model helps organisations retire equipment securely while extending the lifecycle of suitable devices. Fewer assets sent to waste — more practical support for people who need access.</p>
                                        <p class="mb-0" style="color: var(--rw-text-soft); line-height: 1.65;">We focus on clear processes, measurable outcomes, and local partnerships that turn surplus hardware into meaningful community impact.</p>
                                    </div>
                                    <div class="col-lg-5">
                                        <div class="rw-card">
                                            <p class="rw-eyebrow mb-3">Core principles</p>
                                            <p class="mb-2"><span style="color: var(--rw-gold); font-weight: 700;">REPAIR.</span> <span style="color: var(--rw-text-soft);">Keep devices useful for longer.</span></p>
                                            <p class="mb-2"><span style="color: var(--rw-gold); font-weight: 700;">REPURPOSE.</span> <span style="color: var(--rw-text-soft);">Match quality hardware to real needs.</span></p>
                                            <p class="mb-0"><span style="color: var(--rw-gold); font-weight: 700;">REUSE.</span> <span style="color: var(--rw-text-soft);">Reduce waste by design, not by chance.</span></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <t t-call="quote_manage_ui.s_rw_rrr"/>

                        <t t-call="quote_manage_ui.s_rw_newsletter"/>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- 7e. Partners -->
    <record id="partners_page" model="website.page" forcecreate="True">
        <field name="name">Our Partners</field>
        <field name="url">/partners</field>
        <field name="type">qweb</field>
        <field name="is_published">True</field>
        <field name="key">quote_manage_ui.partners_page</field>
        <field name="arch" type="xml">
            <t name="Our Partners" t-name="quote_manage_ui.partners_page">
                <t t-call="website.layout">
                    <div id="wrap" class="rw-site">
                        <section class="s_rw_page_hero rw-page-hero" data-name="Re-Ware Page Hero" data-snippet="s_rw_page_hero">
                            <div class="container">
                                <p class="rw-eyebrow mb-3">Partners</p>
                                <h1 class="mb-3">Our strategic partners.</h1>
                                <p class="lead">We collaborate with technology leaders to deliver the best refurbished solutions for our clients.</p>
                            </div>
                        </section>

                        <section class="s_rw_partners_grid rw-section rw-bg-cream-soft" data-name="Partners grid" data-snippet="s_rw_partners_grid">
                            <div class="container">
                                <div class="row g-4">
                                    <t t-set="partners" t-value="[
                                        {'name': 'Microsoft', 'desc': 'Office 365 Partner &amp; Cloud Solution Provider (CSP)', 'icon': 'fa-windows'},
                                        {'name': 'Apple', 'desc': 'Authorized Reseller for premium hardware and solutions', 'icon': 'fa-apple'},
                                        {'name': 'Lenovo', 'desc': 'DCG Partner providing data centre and laptop solutions', 'icon': 'fa-laptop'},
                                        {'name': 'HP', 'desc': 'Enterprise Partner for high-performance computing and printing', 'icon': 'fa-hdd-o'},
                                        {'name': 'Dell', 'desc': 'Strategic partner for infrastructure and client solutions', 'icon': 'fa-desktop'},
                                        {'name': 'Cisco', 'desc': 'Networking and security solutions partner', 'icon': 'fa-signal'},
                                        {'name': 'Veeam', 'desc': 'Data protection and backup solutions partner', 'icon': 'fa-database'},
                                        {'name': 'Fortinet', 'desc': 'Advanced network security and firewall solutions', 'icon': 'fa-shield'},
                                        {'name': 'Eset', 'desc': 'Cybersecurity and antivirus protection partner', 'icon': 'fa-lock'}
                                    ]"/>
                                    <t t-foreach="partners" t-as="partner">
                                        <div class="col-md-4">
                                            <div class="rw-card text-center">
                                                <div class="fs-1 mb-2" style="color: var(--rw-gold);"><i t-attf-class="fa #{partner['icon']}"/></div>
                                                <h3 t-esc="partner['name']"/>
                                                <p t-esc="partner['desc']"/>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </section>

                        <section class="s_rw_partners_cta rw-section rw-bg-cream" data-name="Partners CTA" data-snippet="s_rw_partners_cta">
                            <div class="container rw-container-narrow text-center">
                                <h2 class="mb-3">Ready to partner with us?</h2>
                                <p class="mb-4" style="color: var(--rw-text-soft); font-size: 1.1rem;">Join our ecosystem of innovation and sustainability.</p>
                                <a href="/contactus" class="rw-btn-coral">Become a partner</a>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    </data>

    <!-- 8. Menus (declared AFTER their page records so ref= resolves) -->
    <record id="menu_services" model="website.menu">
        <field name="name">Services</field>
        <field name="url">/services</field>
        <field name="page_id" ref="quote_manage_ui.services_page"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">3</field>
    </record>

    <record id="menu_about_us" model="website.menu">
        <field name="name">About.</field>
        <field name="url">/aboutus</field>
        <field name="page_id" ref="quote_manage_ui.about_us_page"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">4</field>
    </record>

    <record id="menu_our_why" model="website.menu">
        <field name="name">Our Why.</field>
        <field name="url">/our-why</field>
        <field name="page_id" ref="quote_manage_ui.our_why_page"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">5</field>
    </record>

    <record id="menu_partners" model="website.menu">
        <field name="name">Partners</field>
        <field name="url">/partners</field>
        <field name="page_id" ref="quote_manage_ui.partners_page"/>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">6</field>
    </record>

    <!-- 9. Contact Us -->
    <template id="reware_contactus" inherit_id="website.contactus" name="Reware Contact Us" priority="10">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty rw-site">
                <section class="s_rw_page_hero rw-page-hero" data-name="Re-Ware Page Hero" data-snippet="s_rw_page_hero">
                    <div class="container">
                        <p class="rw-eyebrow mb-3">Contact</p>
                        <h1 class="mb-3">Let's talk.</h1>
                        <p class="lead">Questions about our services, refurbishment, or the Re-Ware project? We'll get back to you within 24 hours.</p>
                    </div>
                </section>

                <section class="s_rw_contact_form rw-section rw-bg-cream-soft" data-name="Contact form" data-snippet="s_rw_contact_form">
                    <div class="container">
                        <div class="row g-5">
                            <div class="col-lg-5">
                                <p class="rw-eyebrow mb-3">Get in touch</p>
                                <h2 class="mb-4">We're here to help.</h2>
                                <div class="mb-4">
                                    <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--rw-text-muted); margin-bottom: 0.4rem;">Email</h4>
                                    <p class="mb-0" style="font-size: 1.1rem;"><a href="mailto:re-ware@cocreativeit.com" style="color: var(--rw-text); text-decoration: none; border-bottom: 1px solid var(--rw-gold); padding-bottom: 1px;">re-ware@cocreativeit.com</a></p>
                                </div>
                                <div class="mb-4">
                                    <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--rw-text-muted); margin-bottom: 0.4rem;">Phone</h4>
                                    <p class="mb-0" style="font-size: 1.1rem;"><a href="tel:0499909302" style="color: var(--rw-text); text-decoration: none;">0499 909 302</a></p>
                                </div>
                                <div class="mb-4">
                                    <h4 style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--rw-text-muted); margin-bottom: 0.4rem;">Location</h4>
                                    <p class="mb-0" style="font-size: 1.1rem;">102 Edward Street, Perth, Western Australia 6000</p>
                                </div>
                            </div>
                            <div class="col-lg-7">
                                <div class="rw-card rw-form" style="padding: 2.5rem;">
                                    <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                        <form id="contactus_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-model_name="crm.lead" data-success-mode="redirect" data-success-page="/contactus-thank-you" data-pre-fill="true">
                                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                                <div class="mb-3 col-12 s_website_form_field s_website_form_required" data-type="char" data-name="Field">
                                                    <label class="form-label s_website_form_label" for="contact1">
                                                        <span class="s_website_form_label_content">Name</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input id="contact1" type="text" class="form-control s_website_form_input" name="contact_name" required="required" data-fill-with="name"/>
                                                </div>
                                                <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="email" data-name="Field">
                                                    <label class="form-label s_website_form_label" for="contact3">
                                                        <span class="s_website_form_label_content">Email</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input id="contact3" type="email" class="form-control s_website_form_input" name="email_from" required="required" data-fill-with="email"/>
                                                </div>
                                                <div class="mb-3 col-12 s_website_form_field s_website_form_required s_website_form_model_required" data-type="char" data-name="Field">
                                                    <label class="form-label s_website_form_label" for="contact5">
                                                        <span class="s_website_form_label_content">Subject</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input id="contact5" type="text" class="form-control s_website_form_input" name="name" required="required"/>
                                                </div>
                                                <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required" data-type="text" data-name="Field">
                                                    <label class="form-label s_website_form_label" for="contact6">
                                                        <span class="s_website_form_label_content">Message</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <textarea id="contact6" class="form-control s_website_form_input" name="description" required="required" rows="5"/>
                                                </div>
                                                <div class="mb-0 py-2 col-12 s_website_form_submit" data-name="Submit Button">
                                                    <a href="#" role="button" class="rw-btn-coral s_website_form_send">Send message</a>
                                                    <span id="s_website_form_result"/>
                                                </div>
                                            </div>
                                        </form>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <!-- ============================================================
         10. Homepage — composed entirely of Re-Ware snippets so the
         Website Editor can re-order / clone / delete each section
         individually. Source of truth for each block lives in
         views/snippets.xml.
         ============================================================ -->
    <template id="homepage_custom" inherit_id="website.homepage" name="Reware Homepage" priority="99">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure oe_empty rw-site">
                <t t-call="quote_manage_ui.s_rw_hero"/>
                <t t-call="quote_manage_ui.s_rw_services"/>
                <t t-call="quote_manage_ui.s_rw_consultation"/>
                <t t-call="quote_manage_ui.s_rw_steps"/>
                <t t-call="quote_manage_ui.s_rw_why"/>
                <t t-call="quote_manage_ui.s_rw_rrr"/>
                <t t-call="quote_manage_ui.s_rw_newsletter"/>
                <t t-call="quote_manage_ui.s_rw_categories"/>
            </div>
        </xpath>
    </template>

    <!-- 11. Blog listing intro — keep using Re-Ware page-hero look -->
    <template id="reware_blog_list_hero" inherit_id="website_blog.blog_post_short" name="Reware Blog Listing Intro" priority="20">
        <xpath expr="//div[@id='o_wblog_blog_top']" position="before">
            <section class="rw-page-hero" t-if="(not blog) or not is_view_active('website_blog.opt_blog_cover_post')">
                <div class="container">
                    <p class="rw-eyebrow mb-3">Journal</p>
                    <h1 class="mb-3">
                        <t t-if="blog"><span t-field="blog.name"/></t>
                        <t t-else="">News</t>
                    </h1>
                    <p class="lead">
                        <t t-if="blog"><span t-field="blog.subtitle" placeholder="Add a short subtitle in the blog settings."/></t>
                        <t t-else="">Stories, guides, and updates from the Re-Ware team.</t>
                    </p>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
