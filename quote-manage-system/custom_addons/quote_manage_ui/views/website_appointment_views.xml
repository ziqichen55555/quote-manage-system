<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_appointment_type_tree" model="ir.ui.view">
        <field name="name">website.appointment.type.tree</field>
        <field name="model">website.appointment.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="duration_minutes"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_website_appointment_type_form" model="ir.ui.view">
        <field name="name">website.appointment.type.form</field>
        <field name="model">website.appointment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="duration_minutes"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_website_appointment_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">website.appointment.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_website_appointment_type"
        name="Appointment Types"
        parent="website.menu_website_configuration"
        action="action_website_appointment_type"
        sequence="45"
    />

    <record id="res_config_settings_view_form_appointment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.appointment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_email_marketing']" position="after">
                <block title="Appointments" id="website_appointment_settings" invisible="not website_id">
                    <setting
                        id="website_appointment_calendar_setting"
                        string="Website appointment calendar"
                        help="Public bookings are created on this user calendar. You can connect this calendar to Outlook later.">
                        <field name="appointment_calendar_user_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
