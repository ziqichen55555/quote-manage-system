<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_mail_server_view_form_graph" model="ir.ui.view">
        <field name="name">ir.mail_server.view.form.inherit.graph</field>
        <field name="model">ir.mail_server</field>
        <field name="inherit_id" ref="base.ir_mail_server_form"/>
        <field name="arch" type="xml">
            <field name="smtp_authentication" position="after">
                <field name="use_microsoft_graph"
                    invisible="smtp_authentication != 'outlook'"/>
            </field>
        </field>
    </record>
</odoo>
