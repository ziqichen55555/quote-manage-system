<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_square_refund_wizard_form" model="ir.ui.view">
        <field name="name">square.refund.wizard.form</field>
        <field name="model">square.refund.wizard</field>
        <field name="arch" type="xml">
            <form string="Refund via Square">
                <group>
                    <field name="move_id"/>
                    <field name="source_payment_id"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="amount"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_refund"
                            type="object"
                            string="Refund"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
