<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_square" model="ir.ui.view">
        <field name="name">account.payment.form.square</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Square" invisible="not square_payment_id and not square_checkout_id and not square_refund_id">
                    <field name="square_payment_id" readonly="1"/>
                    <field name="square_checkout_id" readonly="1"/>
                    <field name="square_refund_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
