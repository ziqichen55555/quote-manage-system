<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_square" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.square</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Square Card Payments" name="square_terminal_setting_container">
                    <setting string="Enable Square Payments"
                             help="Pay Sales Orders with Square Reader (phone app) or Square Terminal. Products and inventory stay in Odoo.">
                        <field name="square_enabled"/>
                        <div class="content-group mt16" invisible="not square_enabled">
                            <div class="row">
                                <label for="square_payment_mode" class="col-lg-3 o_light_label"/>
                                <field name="square_payment_mode"/>
                            </div>
                            <div class="row mt8">
                                <label for="square_environment" class="col-lg-3 o_light_label"/>
                                <field name="square_environment"/>
                            </div>
                            <div class="row mt8" groups="base.group_system">
                                <label for="square_application_id" class="col-lg-3 o_light_label"/>
                                <field name="square_application_id"
                                         placeholder="Sandbox/Production Application ID (for Reader app SDK)"/>
                            </div>
                            <div class="row mt8" groups="base.group_system">
                                <label for="square_access_token" class="col-lg-3 o_light_label"/>
                                <field name="square_access_token" password="True"
                                         placeholder="Paste Square Access Token"/>
                            </div>
                            <div class="row mt8" groups="base.group_system">
                                <label for="square_location_id" class="col-lg-3 o_light_label"/>
                                <field name="square_location_id" placeholder="Location ID"/>
                            </div>
                            <div class="row mt8" groups="base.group_system"
                                 invisible="square_payment_mode != 'terminal'">
                                <label for="square_device_id" class="col-lg-3 o_light_label"/>
                                <field name="square_device_id"
                                         placeholder="Terminal device_id only"/>
                            </div>
                            <div class="row mt8" groups="base.group_system"
                                 invisible="square_payment_mode != 'reader'">
                                <label for="square_mobile_api_key" class="col-lg-3 o_light_label"/>
                                <field name="square_mobile_api_key" password="True"
                                         placeholder="API key for the store phone app"/>
                            </div>
                            <div class="row mt8">
                                <label for="square_journal_id" class="col-lg-3 o_light_label"/>
                                <field name="square_journal_id"
                                         placeholder="Defaults to first bank journal if empty"/>
                            </div>
                            <div class="row mt8" groups="base.group_system">
                                <label for="square_webhook_signature_key" class="col-lg-3 o_light_label"/>
                                <field name="square_webhook_signature_key" password="True"/>
                            </div>
                            <div class="row mt8" groups="base.group_system">
                                <label for="square_webhook_url" class="col-lg-3 o_light_label"/>
                                <field name="square_webhook_url" readonly="1"/>
                            </div>
                            <div class="row mt8" groups="base.group_system"
                                 invisible="square_payment_mode != 'reader'">
                                <label for="square_reader_api_base" class="col-lg-3 o_light_label"/>
                                <field name="square_reader_api_base" readonly="1"/>
                            </div>
                            <div class="mt16 d-flex gap-2" groups="base.group_system">
                                <button name="action_square_test_connection"
                                        type="object"
                                        string="Test connection"
                                        class="btn-secondary"
                                        icon="fa-plug"/>
                                <button name="action_square_generate_mobile_api_key"
                                        type="object"
                                        string="Generate Reader App API Key"
                                        class="btn-secondary"
                                        invisible="square_payment_mode != 'reader'"/>
                            </div>
                            <div class="alert alert-info mt16" role="alert" groups="base.group_system">
                                <strong>Reader mode (recommended for your hardware):</strong>
                                set Hardware Mode to Square Reader, paste Application ID + Access Token + Location ID,
                                generate the Reader App API Key, then configure the Android/iOS companion app
                                with this site URL and API key. The store phone pairs the Bluetooth Reader.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
