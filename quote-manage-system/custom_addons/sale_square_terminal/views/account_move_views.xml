<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_square_refund" model="ir.ui.view">
        <field name="name">account.move.form.square.refund</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_square_refund"
                        type="object"
                        string="Refund via Square"
                        class="btn-secondary"
                        invisible="move_type != 'out_refund' or state != 'posted' or payment_state in ('paid', 'in_payment', 'reversed')"/>
            </xpath>
        </field>
    </record>
</odoo>
