<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_square_pay" model="ir.ui.view">
        <field name="name">sale.order.form.square.pay</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="square_pay_enabled" invisible="1"/>
                <button name="action_square_pay"
                        type="object"
                        string="Pay with Square"
                        class="btn-primary"
                        invisible="not square_pay_enabled or state not in ('draft', 'sent', 'sale') or amount_total &lt;= 0"/>
            </xpath>
        </field>
    </record>
</odoo>
