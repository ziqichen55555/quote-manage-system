<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_xero" model="ir.ui.view">
        <field name="name">account.move.form.xero</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_xero_sync"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cloud-upload"
                        invisible="move_type != 'out_invoice' or state != 'posted'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Push to Xero</span>
                        <span class="o_stat_value">
                            <field name="xero_sync_status" widget="badge"
                                   decoration-success="xero_sync_status == 'synced'"
                                   decoration-danger="xero_sync_status == 'error'"
                                   decoration-warning="xero_sync_status in ('pending', 'skipped')"/>
                        </span>
                    </div>
                </button>
                <button name="action_xero_sync_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="move_type != 'out_invoice' or state != 'posted' or not xero_invoice_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Sync payment</span>
                    </div>
                </button>
                <button name="action_xero_sync_all"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-refresh"
                        invisible="move_type != 'out_invoice' or state not in ('posted', 'cancel')">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Sync all</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Xero" name="xero_sync"
                      invisible="move_type != 'out_invoice'">
                    <div class="alert alert-success mb-3" role="alert"
                         invisible="xero_sync_status != 'synced'">
                        <strong>Xero: synced</strong>
                        <field name="xero_sync_message" nolabel="1" readonly="1" class="d-block mt-1"/>
                    </div>
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="xero_sync_status != 'error'">
                        <strong>Xero: failed</strong>
                        <field name="xero_sync_message" nolabel="1" readonly="1" class="d-block mt-1"/>
                    </div>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="xero_sync_status != 'skipped'">
                        <strong>Xero: skipped</strong>
                        <field name="xero_sync_message" nolabel="1" readonly="1" class="d-block mt-1"/>
                    </div>
                    <group>
                        <field name="xero_invoice_id" readonly="1"/>
                        <field name="xero_sync_status" readonly="1"/>
                    </group>
                    <group string="Linked payments">
                        <p class="text-muted">
                            After registering payment on this invoice, use
                            <strong>Sync payment</strong> above. Success or failure
                            is shown here and in the invoice chatter.
                        </p>
                    </group>
                    <button name="action_open_xero_sync_logs"
                            type="object"
                            string="View sync logs"
                            class="btn-secondary"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_xero" model="ir.ui.view">
        <field name="name">account.move.tree.xero</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="xero_sync_status" optional="show" widget="badge"
                       decoration-success="xero_sync_status == 'synced'"
                       decoration-danger="xero_sync_status == 'error'"
                       decoration-warning="xero_sync_status in ('pending', 'skipped')"/>
            </xpath>
        </field>
    </record>

</odoo>
