<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="xero_oauth_result" name="Xero OAuth Result">
        <t t-call="web.layout">
            <div class="container py-5">
                <div class="card shadow-sm mx-auto" style="max-width: 640px;">
                    <div class="card-body p-4">
                        <h1 class="h3 mb-3">
                            <t t-if="success">Xero connected</t>
                            <t t-else="">Xero connection failed</t>
                        </h1>
                        <p class="mb-4" t-esc="message"/>
                        <a href="/web#action=account.action_account_config" class="btn btn-primary">
                            Back to Accounting Settings
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <record id="view_xero_sync_log_tree" model="ir.ui.view">
        <field name="name">xero.sync.log.tree</field>
        <field name="model">xero.sync.log</field>
        <field name="arch" type="xml">
            <tree string="Xero Sync Logs" create="false" edit="false">
                <field name="create_date"/>
                <field name="operation"/>
                <field name="record_name"/>
                <field name="status"/>
                <field name="xero_id"/>
                <field name="message"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_xero_sync_log_form" model="ir.ui.view">
        <field name="name">xero.sync.log.form</field>
        <field name="model">xero.sync.log</field>
        <field name="arch" type="xml">
            <form string="Xero Sync Log" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="operation"/>
                        <field name="status"/>
                        <field name="xero_id"/>
                        <field name="record_name"/>
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_xero_sync_log" model="ir.actions.act_window">
        <field name="name">Xero Sync Logs</field>
        <field name="res_model">xero.sync.log</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
