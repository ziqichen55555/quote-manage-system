<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_xero" model="ir.ui.view">
        <field name="name">account.payment.form.xero</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Xero" invisible="payment_type != 'inbound'">
                    <div class="alert alert-success mb-2" role="alert"
                         invisible="xero_sync_status != 'synced'">
                        <strong>Synced</strong>
                        <field name="xero_sync_message" nolabel="1" readonly="1" class="d-block mt-1"/>
                    </div>
                    <div class="alert alert-danger mb-2" role="alert"
                         invisible="xero_sync_status != 'error'">
                        <strong>Failed</strong>
                        <field name="xero_sync_message" nolabel="1" readonly="1" class="d-block mt-1"/>
                    </div>
                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="xero_sync_status != 'skipped'">
                        <strong>Skipped</strong>
                        <field name="xero_sync_message" nolabel="1" readonly="1" class="d-block mt-1"/>
                    </div>
                    <field name="xero_payment_id" readonly="1"/>
                    <field name="xero_sync_status" readonly="1"/>
                    <button name="action_xero_sync"
                            type="object"
                            string="Push payment to Xero"
                            class="btn-secondary"
                            invisible="state != 'posted'"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
