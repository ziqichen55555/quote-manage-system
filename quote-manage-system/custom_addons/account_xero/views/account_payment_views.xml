<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_xero" model="ir.ui.view">
        <field name="name">account.payment.form.xero</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Xero" invisible="payment_type != 'inbound'">
                    <field name="xero_payment_id" readonly="1"/>
                    <field name="xero_sync_status" readonly="1"/>
                    <field name="xero_sync_message" readonly="1"/>
                    <button name="action_xero_sync"
                            type="object"
                            string="Push to Xero"
                            class="btn-secondary"
                            invisible="state != 'posted'"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
