<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_xero" model="ir.ui.view">
        <field name="name">account.payment.form.xero</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Xero" invisible="payment_type != 'inbound'">
                    <div class="alert alert-warning mb-2" role="alert">
                        <strong>Not synced to Xero</strong>
                        <p class="mb-0 mt-1">
                            Payments stay in Odoo (method and status). Only the
                            linked customer invoice is pushed to Xero.
                        </p>
                    </div>
                    <field name="xero_payment_id" readonly="1" invisible="not xero_payment_id"/>
                    <field name="xero_sync_status" readonly="1" invisible="not xero_sync_status"/>
                    <field name="xero_sync_message" readonly="1" invisible="not xero_sync_message"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
