# 生产环境 .env 模板
# 用法：复制为 .env，然后填好下面三项
#   cp .env.prod.example .env

# DuckDNS 子域名（或将来的正式域名）
# 例：reware-app.duckdns.org
# 未来切回主域名时直接改成：reware-project.com
SITE_HOSTNAME=your-subdomain.duckdns.org

# Let's Encrypt 提醒邮件（证书快过期时会发邮件，建议填真实邮箱）
ACME_EMAIL=you@example.com

# Postgres / Odoo 数据库密码（生产必须改，别用 odoo）
# 推荐生成：openssl rand -base64 24
POSTGRES_PASSWORD=please-change-me-to-a-strong-password

# （可选）Odoo「从 Google 获取产品图片」— 需在 Google Cloud / PSE 控制台自行创建
# 配置后运行：scripts/setup_google_product_images.py
# GOOGLE_CUSTOM_SEARCH_KEY=your-api-key
# GOOGLE_PSE_ID=your-search-engine-id
